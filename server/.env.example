# 复制为 server/.env 并按需填写（server 启动时会自动读取 server/.env）。
# 不要把这个文件（含真实密钥）提交到 git —— server/.gitignore 已忽略 .env。

# ---- "大脑"：一次性无头编码智能体 CLI ----
# 默认用 OpenAI Codex CLI 的无头模式（codex exec）；也可换 Claude Code（claude -p）等
# 任何"能写文件、跑 shell、跑完自行退出"的 agentic CLI。
# 模板占位符：{prompt_file} 提示词文件路径、{job_dir} 任务目录、{repo} 仓库根目录。
AGENT_CMD='codex exec --sandbox danger-full-access --skip-git-repo-check "$(cat {prompt_file})"'
# Codex 若仍会停下来要确认，追加 --approval-policy never（取值以 codex exec --help 为准）。
# 想用 DeepSeek 模型：在 ~/.codex/config.toml 配 model_providers 指向 https://api.deepseek.com。
# 换成 Claude Code 的写法（二选一，取消注释并注释掉上面那行）：
# AGENT_CMD='claude -p "$(cat {prompt_file})" --allowedTools "Bash,Read,Write,Edit,Glob,Grep" --permission-mode bypassPermissions --output-format text'
# 单个任务的最长运行时间（秒），超时会被 kill 并标记失败。
AGENT_TIMEOUT_SEC=1800

# ---- MiniMax 配音（server/tts_minimax.py 使用，凭据注入给 agent 子进程）----
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_GROUP_ID=your_minimax_group_id
MINIMAX_MODEL=speech-02-turbo
MINIMAX_VOICE_ID=your_voice_id
# 如接口端点/字段与你的账户不一致，改 tts_minimax.py 里的 synth()。
# MINIMAX_BASE_URL=https://api.minimax.chat/v1/t2a_v2

# ---- 可选 ----
# DEFAULT_STYLE=whiteboard
# MAX_UPLOAD_MB=20
# PORT=8000
